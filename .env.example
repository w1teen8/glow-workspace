# Скопируй в .env.local для локальной работы. На Render задаются DATABASE_URL, PERSON_A и PERSON_B.

# Строка подключения Neon (Dashboard → Connection string, вариант "pooled")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Общий аккаунт. Нужны только для `npm run setup`, который создаёт или обновляет учётку.
# После запуска setup пароль можно удалить отсюда — в базе хранится только bcrypt-хэш.
ADMIN_LOGIN=glow
ADMIN_PASSWORD=придумай-длинный-пароль

# Имена для поля «исполнитель»
PERSON_A=Первый
PERSON_B=Второй
